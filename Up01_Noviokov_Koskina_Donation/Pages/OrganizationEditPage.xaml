<Page x:Class="Up01_Noviokov_Koskina_Donation.Pages.OrganizationEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Up01_Noviokov_Koskina_Donation.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Оргнизация" Style="{DynamicResource PageStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource PanelBorder}" Width="520" Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Название *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="NameBox" MaxLength="150" TextChanged="Field_Changed" ToolTip="Уникальное название до 150 символов"/>
                    <TextBlock x:Name="NameHint" Text="Например, Фонд Добро рядом" Style="{StaticResource HintText}"/>
                </Grid>
                <TextBlock Text="Описание *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="DescriptionBox" MaxLength="1000" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Field_Changed" ToolTip="Чем заниимается организация, до 1000 символов"/>
                    <TextBlock x:Name="DescriptionHint" Text="Кратко о деятельности организации" Style="{StaticResource HintText}" VerticalAlignment="Top" Margin="12,10,0,0"/>
                </Grid>
                <TextBlock Text="Контактный e-mail *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="EmailBox" MaxLength="100" TextChanged="Field_Changed" ToolTip="Адрес электронной почты в формате name@domain.ru"/>
                    <TextBlock x:Name="EmailHint" Text="info@fond.ru" Style="{StaticResource HintText}"/>
                </Grid>
                <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="PhoneBox" MaxLength="20" TextChanged="Field_Changed" ToolTip="Необязательно. 11 цифр, начинается с +7 или 8"/>
                    <TextBlock x:Name="PhoneHint" Text="+7 (999) 123-45-67" Style="{StaticResource HintText}"/>
                </Grid>
                <TextBlock Text="Адрес" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="AddressBox" MaxLength="200" TextChanged="Field_Changed" ToolTip="Необязательно, до 200 символов"/>
                    <TextBlock x:Name="AddressHint" Text="г. Москваб ул. Ленина, д. 1" Style="{StaticResource HintText}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Сохранить" ToolTip="Сохранить и вернуться к списку" Click="SaveButton_Click"/>
                    <Button Content="Отмена" ToolTip="Вернуться без сохранения" Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
