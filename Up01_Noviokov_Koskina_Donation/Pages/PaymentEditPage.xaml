<Page x:Class="Up01_Noviokov_Koskina_Donation.Pages.PaymentEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пожертвование"
      Style="{DynamicResource PageStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource PanelBorder}" Width="600" Margin="0,20"
                HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource TitleText}"/>

                <TextBlock Text="Донор *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="UserBox" DisplayMemberPath="FIO" SelectedValuePath="ID"
                          ToolTip="Зарегистрированный пользователь, сделавший пожертвование"/>

                <TextBlock Text="Сбор *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CampaignBox" DisplayMemberPath="Name" SelectedValuePath="ID"
                          ToolTip="На какой сбор поступили деньги"/>

                <TextBlock Text="Способ оплаты *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="MethodBox" DisplayMemberPath="Name" SelectedValuePath="ID"
                          ToolTip="Как был сделан платёж"/>

                <TextBlock Text="Дата *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="PaymentDatePicker" ToolTip="Дата платежа, не позже сегодня"/>

                <TextBlock Text="Назначение *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="NameBox" MaxLength="150" TextChanged="Field_Changed"
                             ToolTip="Назначение платежа, до 150 символов"/>
                    <TextBlock x:Name="NameHint" Text="Например, Пожертвование на рюкзаки" Style="{StaticResource HintText}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Количество * (1–1000)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NumBox" MaxLength="4" TextChanged="Field_Changed"
                                 ToolTip="Целое число от 1 до 1000"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Сумма за единицу, ₽ *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PriceBox" MaxLength="13" TextChanged="Field_Changed"
                                 ToolTip="От 0,01 до 1 000 000 000. Дробная часть — через запятую"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="TotalText" Margin="5" FontWeight="SemiBold"/>

                <TextBlock Text="Статус *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="StatusBox" SelectedValuePath="Tag" ToolTip="В собранную сумму считаются только зачисленные">
                    <ComboBoxItem Content="Ожидает" Tag="Pending"/>
                    <ComboBoxItem Content="Зачислен" Tag="Completed"/>
                    <ComboBoxItem Content="Отменён" Tag="Cancelled"/>
                    <ComboBoxItem Content="Возвращён" Tag="Refunded"/>
                </ComboBox>

                <CheckBox x:Name="AnonymousBox" Content="Анонимное пожертвование (ФИО донора не показывается)"
                          Margin="5,10,5,5" ToolTip="В списках и отчётах будет «Анонимный донор»"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Сохранить" IsDefault="True" ToolTip="Сохранить и вернуться к списку" Click="SaveButton_Click"/>
                    <Button Content="Отмена" ToolTip="Вернуться без сохранения" Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>