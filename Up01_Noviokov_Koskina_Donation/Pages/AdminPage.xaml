<Page x:Class="Up01_Noviokov_Koskina_Donation.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Up01_Noviokov_Koskina_Donation.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Панель администратора" Style="{DynamicResource PageStyle}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="HelloText" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>
        <TextBlock Text="Выберите раздел для работы" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <UniformGrid Columns="3">
            <Button Content="Пользователи" Tag="Users" Style="{StaticResource MenuButton}" ToolTip="Учётные записи и роли" Click="Menu_Click"/>
            <Button Content="Организации" Tag="Organizations" Style="{StaticResource MenuButton}" ToolTip="Благотворительные организации" Click="Menu_Click"/>
            <Button Content="Категории" Tag="Categories" Style="{StaticResource MenuButton}" ToolTip="Направления помощи" Click="Menu_Click"/>
            <Button Content="Сборы" Tag="Campaigns" Style="{StaticResource MenuButton}" ToolTip="Сборы пожертвований" Click="Menu_Click"/>
            <Button Content="Способы оплаты" Tag="PaymentMethods" Style="{StaticResource MenuButton}" ToolTip="Справочник способов оплаты" Click="Menu_Click"/>
            <Button Content="Пожертвования" Tag="Payments" Style="{StaticResource MenuButton}" ToolTip="Платежи по сборам" Click="Menu_Click"/>
            <Button Content="Отчёты о расходах" Tag="Reports" Style="{StaticResource MenuButton}" ToolTip="На что потрачены собранные средства" Click="Menu_Click"/>
            <Button Content="Диаграмма и экспорт" Tag="Diagram" Style="{StaticResource MenuButton}" ToolTip="Диаграмма, отчёты Word, PDF и Excel" Click="Menu_Click"/>
            <Button Content="Каталог сборов" Tag="Catalog" Style="{StaticResource MenuButton}" ToolTip="Каталог глазами пользователя" Click="Menu_Click"/>
        </UniformGrid>
    </StackPanel>
</Page>
