<Page x:Class="Up01_Noviokov_Koskina_Donation.Pages.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пожертвования"
      Style="{DynamicResource PageStyle}"
      IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <Grid Width="260">
                <TextBox x:Name="SearchBox" ToolTip="Поиск по донору, назначению или сбору" TextChanged="Filter_Changed"/>
                <TextBlock x:Name="SearchHint" Text="Донор, назначение, сбор..." Style="{StaticResource HintText}"/>
            </Grid>
            <ComboBox x:Name="StatusFilterBox" Width="170" SelectedIndex="0"
                      ToolTip="Фильтр по статусу" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все статусы" Tag=""/>
                <ComboBoxItem Content="Ожидает" Tag="Pending"/>
                <ComboBoxItem Content="Зачислен" Tag="Completed"/>
                <ComboBoxItem Content="Отменён" Tag="Cancelled"/>
                <ComboBoxItem Content="Возвращён" Tag="Refunded"/>
            </ComboBox>
            <ComboBox x:Name="CampaignFilterBox" Width="260" DisplayMemberPath="Name"
                      ToolTip="Фильтр по сбору" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="SortBox" Width="200" SelectedIndex="0"
                      ToolTip="Порядок сортировки" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Сначала новые"/>
                <ComboBoxItem Content="Сначала старые"/>
                <ComboBoxItem Content="По сумме (по убыванию)"/>
            </ComboBox>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="10,0"/>
        </WrapPanel>

        <DataGrid x:Name="ItemsGrid" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90"/>
                <DataGridTextColumn Header="Донор" Binding="{Binding DonorName, Mode=OneWay}" Width="1.5*"/>
                <DataGridTextColumn Header="Сбор" Binding="{Binding Campaign.Name}" Width="2*"/>
                <DataGridTextColumn Header="Назначение" Binding="{Binding Name}" Width="1.5*"/>
                <DataGridTextColumn Header="Способ" Binding="{Binding PaymentMethod.Name}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Num}" Width="65"/>
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Price, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Итого, ₽" Binding="{Binding Total, Mode=OneWay, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText, Mode=OneWay}" Width="*"/>
                <DataGridCheckBoxColumn Header="Анон." Binding="{Binding IsAnonymous}" Width="60"/>
                <DataGridTemplateColumn Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Изменить" Style="{StaticResource SmallButton}"
                                    ToolTip="Редактировать запись" Click="EditButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Добавить" ToolTip="Зарегистрировать пожертвование" Click="AddButton_Click"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}"
                    ToolTip="Удалить выделенные строки (несколько — с зажатым Ctrl)" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Page>