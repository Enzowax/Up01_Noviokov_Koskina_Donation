<Page x:Class="Up01_Noviokov_Koskina_Donation.Pages.UserEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Up01_Noviokov_Koskina_Donation.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Пользователь" Style="{DynamicResource PageStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource PanelBorder}" Width="560" Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Логин *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="LoginBox" MaxLength="50" TextChanged="Field_Changed" ToolTip="От 3 до 50 символов: латинские буквы, цифры, _"/>
                    <TextBlock x:Name="LoginHint" Text="Например ivan_petrov" Style="{StaticResource HintText}"/>
                </Grid>
                <TextBlock Text="ФИО *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="FioBox" MaxLength="150" TextChanged="Field_Changed" ToolTip="Фамилия, имя и отчество через пробел"/>
                    <TextBlock x:Name="FioHint" Text="Иванов Иван Иванович" Style="{StaticResource HintText}"/>
                </Grid>
                <TextBlock Text="Роль *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="RoleBox" ToolTip="Администратор имеет доступ к редактированию всех таблиц">
                    <ComboBoxItem Content="Пользователь" Tag="User"/>
                    <ComboBoxItem Content="Администратор" Tag="Admin"/>
                </ComboBox>
                <TextBlock x:Name="PasswordLabel" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                <PasswordBox x:Name="PasswordBox" MaxLength="50" ToolTip="Не менее 6 символов, латинские буквы и хотя бы одна цифра"/>
                <TextBlock Text="Фотография" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <Border Width="120" Height="120" Margin="5" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <Image x:Name="PhotoImage" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Button Content="Выбрать фото..." ToolTip="Файл JPG, PNG или BMP" Click="ChoosePhotoButton_Click"/>
                        <Button Content="Убрать фото" ToolTip="Оставить без фотографии" Click="ClearPhotoButton_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Сохранить" IsDefault="True" ToolTip="Сохранить и вернуться к списку" Click="SaveButton_Click"/>
                    <Button Content="Отмена" ToolTip="Вернуться без сохранения" Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
