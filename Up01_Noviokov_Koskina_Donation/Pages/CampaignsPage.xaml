<Page x:Class="Up01_Noviokov_Koskina_Donation.Pages.CampaignsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Up01_Noviokov_Koskina_Donation.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Сборы" Style="{DynamicResource PageStyle}" IsVisibleChanged="Page_IsVisibleChanged">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <Grid Width="260">
                <TextBox x:Name="SearchBox" ToolTip="Поиск по названию сбора" TextChanged="Filter_Changed"/>
                <TextBlock x:Name="SearchHint" Text="Поиск по названию..." Style="{StaticResource HintText}"/>
            </Grid>
            <ComboBox x:Name="StatusFilterBox" Width="170" SelectedIndex="0" ToolTip="Фильтр по статусу" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все статусы" Tag=""/>
                <ComboBoxItem Content="Черновик" Tag="Draft"/>
                <ComboBoxItem Content="Идёт сбор" Tag="Active"/>
                <ComboBoxItem Content="Завершён" Tag="Closed"/>
                <ComboBoxItem Content="Отменён" Tag="Cancelled"/>
            </ComboBox>
            <ComboBox x:Name="CategoryFilterBox" Width="230" DisplayMemberPath="Name" ToolTip="Фильтр по категории" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="SortBox" Width="220" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="По названию (А-Я)"/>
                <ComboBoxItem Content="Сначала новые"/>
                <ComboBoxItem Content="По цели (по убыванию)"/>
                <ComboBoxItem Content="По прогрессу (по убыванию)"/>
            </ComboBox>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="10,0"/>
        </WrapPanel>
        <DataGrid x:Name="ItemsGrid" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Организация" Binding="{Binding Organization.Name}" Width="1.5*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="1.5*"/>
                <DataGridTextColumn Header="Цель, ₽" Binding="{Binding TargetAmount, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Собрано, ₽" Binding="{Binding CollectedAmount, Mode=OneWay, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="%" Binding="{Binding Progress, Mode=OneWay, StringFormat={}{0:N0}%}" Width="55"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="Сроки" Binding="{Binding PeriodText, Mode=OneWay}" Width="1.5*"/>
                <DataGridTemplateColumn Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Изменить" Style="{StaticResource SmallButton}" ToolTip="Редактировать запись" Click="EditButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Добавить" ToolTip="Создать новый сбор" Click="AddButton_Click"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}" ToolTip="Удалить выделенные строки (несколько - с зажатым Ctrl)" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
