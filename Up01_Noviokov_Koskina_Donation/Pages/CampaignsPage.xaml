<Page x:Class="Up01_Noviokov_Koskina_Donation.Pages.CampaignsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Up01_Noviokov_Koskina_Donation.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Сборы" Style="{DynamicResource PageStyle}" IsVisibleChanged="Page_IsVisibleChanged">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <Grid Width="260">
                <TextBox x:Name="SearchBox" ToolTip="Поиск по названию сбора" TextChanged="Filter_Changed"/>
                <TextBlock x:Name="SearchHint" Text="Поиск по названию..." Style="{StaticResource HintText}"/>
            </Grid>
            <ComboBox x:Name="StatusFilterBox" Width="170" SelectedIndex="0" ToolTip="Фильтр по статусу" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все статусы" Tag=""/>
                <ComboBoxItem Content="Черновик" Tag="Draft"/>
                <ComboBoxItem Content="Идёт сбор" Tag="Active"/>
            </ComboBox>
        </WrapPanel>
    </Grid>
</Page>
