<Page x:Class="Up01_Noviokov_Koskina_Donation.Pages.DiagramPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      Title="Диаграмма и отчёты"
      Style="{DynamicResource PageStyle}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <TextBlock Text="Организация:" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox x:Name="OrganizationBox" Width="260" DisplayMemberPath="Name"
                      ToolTip="Чьи сборы учитывать" SelectionChanged="Chart_Changed"/>
            <TextBlock Text="Тип диаграммы:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="ChartTypeBox" Width="200" SelectedIndex="0"
                      ToolTip="Вид диаграммы" SelectionChanged="Chart_Changed">
                <ComboBoxItem Content="Столбцы" Tag="Column"/>
                <ComboBoxItem Content="Горизонтальные полосы" Tag="Bar"/>
                <ComboBoxItem Content="Круговая" Tag="Pie"/>
                <ComboBoxItem Content="Кольцевая" Tag="Doughnut"/>
                <ComboBoxItem Content="Линия" Tag="Line"/>
            </ComboBox>
        </WrapPanel>

        <WindowsFormsHost Grid.Row="1" Margin="5">
            <charts:Chart x:Name="DonationsChart">
                <charts:Chart.Legends>
                    <charts:Legend/>
                </charts:Chart.Legends>
            </charts:Chart>
        </WindowsFormsHost>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отчёт в Word и PDF" Width="200"
                    ToolTip="Отчёт по каждому сбору с таблицей пожертвований" Click="WordButton_Click"/>
            <Button Content="Отчёт в Excel" Width="200"
                    ToolTip="Сводная таблица по всем сборам с итогами" Click="ExcelButton_Click"/>
        </StackPanel>
    </Grid>
</Page>