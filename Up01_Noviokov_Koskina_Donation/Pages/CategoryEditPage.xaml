<Page x:Class="Up01_Noviokov_Koskina_Donation.Pages.CategoryEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Style="{DynamicResource PageStyle}">

    <Border Style="{StaticResource PanelBorder}" Width="450"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Название категории" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <TextBox x:Name="NameBox" MaxLength="100"
                         ToolTip="Уникальное название, до 100 символов"
                         TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="NameHint" Text="Введите название" Style="{StaticResource HintText}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Сохранить" Click="SaveButton_Click"/>
                <Button Content="Отмена" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Page>