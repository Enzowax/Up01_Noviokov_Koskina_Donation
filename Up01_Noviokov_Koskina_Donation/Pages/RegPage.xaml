<Page x:Class="Up01_Noviokov_Koskina_Donation.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Up01_Noviokov_Koskina_Donation.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регестрация" Style="{DynamicResource PageStyle}" >
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource PanelBorder}" Width="420" Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Новая учётная запись" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>
                <TextBlock Text="Логин *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="LoginBox" MaxLength="50" TextChanged="Field_Changed"  ToolTip="От 3 до 50 символов: латинские буквы, цифры, _"/>
                    <TextBlock x:Name="LoginHint" Text="Например, ivan_petrov" Style="{StaticResource HintText}"/>
                </Grid>
                <TextBlock Text="ФИО *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox x:Name="FioBox" MaxLength="150" TextChanged="Field_Changed" ToolTip="Фамилия, имя и отчество через пробел (только буквы)"/>
                    <TextBlock x:Name="FioHint" Text="Иванов Иван Иванович" Style="{StaticResource HintText}"/>
                </Grid>
                <TextBlock Text="Паровль *" Style="{StaticResource FieldLabel}"/> 
                <Grid>
                    <PasswordBox x:Name="PasswordBox" MaxLength="50" PasswordChanged="Field_Changed" ToolTip="Не менее 6 символов, латинские буквы и хотябы одна цифра"/>
                    <TextBlock x:Name="PasswordHint" Text="Не менее 6 символов" Style="{StaticResource HintText}"/>
                </Grid>
                <TextBlock Text="Повтор пароля *" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <PasswordBox x:Name="ConfirmBox" MaxLength="50" PasswordChanged="Field_Changed" ToolTip="Введите паровль ещё раз"/>
                    <TextBlock x:Name="ConfirmHint" Text="Повторить пароль" Style="{StaticResource HintText}"/>
                </Grid>
                <TextBlock Text="Роль" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="RoleBox" SelectedIndex="0" ToolTip="Роль определяет, какие функции доступны">
                    <ComboBoxItem Content="Пользователь" Tag="User"/>
                    <ComboBoxItem Content="Администратор" Tag="Admin"/>
                </ComboBox>
                <Button Content="Зарегестрироваться" IsDefault="True" Width="Auto" Margin="5,15,5,5" ToolTip="Создать учётную запись" Click="RegisterButton_Click"/>
                <Button Content="Отмена" Width="Auto" ToolTip="Вернуться к входу" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
